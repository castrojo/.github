{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "version": 1,
  "description": "Auto-QA self-tuning configuration for tuna-os/.github",
  "tuning": {
    "enabled": true,
    "strategy": "outcome-based",
    "evaluation": {
      "metric": "pass-rate",
      "target": 0.95,
      "window_size": 20
    },
    "thresholds": {
      "min_quality_score": 0.8,
      "escalation_threshold": 0.6
    }
  }
}
